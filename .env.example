# RINO — Plataforma de Investigação OSINT.
# Variáveis do produto usam o prefixo RINO_ (o prefixo legado OSINTIZADA_ ainda é aceito).
# Copie para .env (fora do Git) e preencha somente o que for contratado/autorizado.
# Nunca commitar o .env real. A API e a CLI exibem apenas a forma mascarada (ex.: sk-****37ad).

# --- Banco de dados ---
# Padrão: SQLite em data/osintizada.db. Produção:
# DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/osintizada

# --- Redis (fila de jobs, locks, cache compartilhado, heartbeats) ---
# Sem REDIS_URL: a API funciona, mas jobs ficam PENDING (QUEUE_UNAVAILABLE) — nada é simulado.
# Com senha/TLS: REDIS_URL=rediss://:SENHA@host:6380/0   (a senha nunca aparece em logs/API)
# REDIS_URL=redis://127.0.0.1:6379/0
# Opcional: cache num Redis/DB separado (política LRU); a fila precisa de noeviction.
# REDIS_CACHE_URL=redis://127.0.0.1:6379/1

# --- API ---
# Obrigatório para expor a API fora de 127.0.0.1:
# RINO_API_TOKEN=
# RINO_AUTO_MIGRATE=1

# --- Search engines ---
# Brave Search API: https://brave.com/search/api/
# BRAVE_SEARCH_API_KEY=
# Google Programmable Search (Custom Search JSON API) — somente contas com acesso
# GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_CX=

# --- Telegram (API oficial, sessão legítima) — https://my.telegram.org ---
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_SESSION=          # StringSession de uma conta já autenticada

# --- Infraestrutura (opcionais) ---
# RINO_DNS_SERVERS=1.1.1.1,8.8.8.8   # padrão: resolver do sistema
# RINO_RDAP_BASE=https://rdap.org
# RINO_PSL_FILE=/caminho/public_suffix_list.dat   # PSL mais recente que a embutida

# --- IA auxiliar (opcional; docs/AI.md) ---
# Modo: LOCAL_ONLY (padrão, nada sai da máquina) | HYBRID | CLOUD
# RINO_AI_MODE=LOCAL_ONLY
# Llama local via Ollama (instale e baixe o modelo VOCÊ MESMO: ollama pull <modelo>)
# RINO_AI_LLAMA_ENABLED=true
# RINO_AI_LLAMA_BASE_URL=http://127.0.0.1:11434
# RINO_AI_LLAMA_MODEL=
# RINO_AI_LLAMA_RUNTIME=ollama            # ou openai (llama.cpp server / LM Studio)
# RINO_AI_LOCAL_TIMEOUT=180
# RINO_AI_CLOUD_TIMEOUT=120
# RINO_AI_ALLOW_CLOUD_FALLBACK=false
# Nuvem (opcional): Claude (pip install -e ".[ai-cloud]") e/ou OpenAI
# ANTHROPIC_API_KEY=
# RINO_AI_CLAUDE_MODEL=claude-opus-5-5
# OPENAI_API_KEY=
# RINO_AI_OPENAI_MODEL=

# Caminho alternativo do arquivo de configuração
# RINO_CONFIG=config/rino.yaml

# --- Fases seguintes (ainda não integrados) ---
# GITHUB_TOKEN=
# VIRUSTOTAL_API_KEY=
# SHODAN_API_KEY=
# CENSYS_API_ID=
# CENSYS_API_SECRET=
# ABUSEIPDB_API_KEY=
# CREDILINK_WS_USER=
# CREDILINK_WS_TOKEN=
